APP_NAME=GuitarBattle API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

POSTGRES_DB=guitarbattle
POSTGRES_USER=guitarbattle_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Host interface for the published API port. Use 0.0.0.0 only with a firewall.
API_BIND_HOST=127.0.0.1

# Generated client assets (manifest.json + bundle.zip) served at
# /api/v1/client-assets. In Docker Compose this path is backed by the
# client_assets_data named volume.
CLIENT_ASSETS_DIR=/data/client_assets

# Transactional email for email confirmation and password recovery.
# Fill these in for production. If SMTP_HOST is empty, development logs the
# message instead of sending it; production returns 503 from registration.
#
# Yandex Cloud Postbox (SMTP with an API key), see docs/YANDEX_POSTBOX.md:
#   SMTP_HOST=postbox.cloud.yandex.net
#   SMTP_PORT=587
#   SMTP_SECURITY=starttls
#   SMTP_USERNAME=<YANDEX_CLOUD_API_KEY_ID>
#   SMTP_PASSWORD=<YANDEX_CLOUD_API_KEY_SECRET>
# Port 587 uses STARTTLS; port 465 uses SMTPS (SMTP_SECURITY=ssl).
# SMTP_USERNAME is the API key ID (scope yc.postbox.send), not the service
# account ID. Never commit the real secret.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_FROM_EMAIL=noreply@fretfight.online
SMTP_FROM_NAME=GuitarBattle
SMTP_TIMEOUT_SECONDS=10

EMAIL_CODE_EXPIRE_MINUTES=15
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
