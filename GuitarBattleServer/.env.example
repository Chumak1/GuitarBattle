APP_NAME=GuitarBattle API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

POSTGRES_DB=guitarbattle
POSTGRES_USER=guitarbattle_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Persistent sessions: a rotating refresh token lives 30 days. The web app keeps
# it in the HttpOnly `ff_refresh` cookie; the desktop client gets it in the login
# response. Cookies are marked Secure only on HTTPS unless pinned with
# REFRESH_COOKIE_SECURE=always (auto|always|never). REFRESH_REUSE_GRACE_SECONDS
# treats a just-rotated token as a two-tab race instead of theft.
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_SECURE=auto
REFRESH_REUSE_GRACE_SECONDS=15

# Host interface for the published API port. Use 0.0.0.0 only with a firewall.
API_BIND_HOST=127.0.0.1

# Generated client assets (manifest.json + bundle.zip) served at
# /api/v1/client-assets. In Docker Compose this path is backed by the
# client_assets_data named volume.
CLIENT_ASSETS_DIR=/data/client_assets

# Landing page CMS uploads (hero image/video). The API stores files here and
# publishes them at /media/landing/<name>; Docker Compose backs this path with
# the landing_media_data volume.
LANDING_MEDIA_DIR=/data/landing_media
MAX_LANDING_MEDIA_BYTES=52428800

# Battle tower covers uploaded in the admin panel ("Кампании" → обложка).
# Published at /media/campaigns/<name>; the default directory is a
# subdirectory of the landing media volume, so no extra volume is needed.
CAMPAIGN_MEDIA_DIR=/data/landing_media/campaigns
MAX_CAMPAIGN_COVER_BYTES=2097152

# Desktop game builds (.exe/.zip/.msi) offered at /api/v1/downloads/game.
# Backed by the game_builds_data volume; the active build is chosen in admin.
GAME_BUILDS_DIR=/data/game_builds
MAX_GAME_BUILD_BYTES=524288000

# Global background music (one MP3 for non-gameplay screens), published at
# /api/v1/app/background-music. Backed by the app_audio_data volume.
APP_AUDIO_DIR=/data/app_audio

# Gameplay visuals managed in the admin panel: UI-level character spritesheets
# (characters/) and stage backgrounds (stages/). Published at
# /media/characters/<name> and /media/stages/<name>. Backed by the
# gameplay_media_data volume. Character sheets must be transparent PNGs with
# eight poses in a 4x2 grid; stage backgrounds accept PNG or JPEG.
GAMEPLAY_MEDIA_DIR=/data/gameplay_media
MAX_GAMEPLAY_MEDIA_BYTES=16777216

# UI sounds managed in the admin panel ("Звуки интерфейса"). Short clips are
# stored in GAMEPLAY_MEDIA_DIR/ui_sounds and published through
# /api/v1/ui-sounds/manifest; the per-file upload limit is 2 MiB.
MAX_UI_SOUND_BYTES=2097152

# DB-IP Lite country database for IP-based language detection at /api/v1/geo.
# Download it with scripts/fetch_geoip.py; backed by the geoip_data volume.
# If the file is missing, /api/v1/geo returns null country and language.
GEOIP_DB_PATH=/data/geoip/dbip-country-lite.mmdb

# Country of registration and sign-in for the admin panel (a different
# mechanism from GEOIP_DB_PATH above). The IP is stored on the user row and
# resolved in the background through a free HTTPS service without an API key.
# Set GEOIP_ENABLED=false to skip the lookup; IPs are still stored. The lookup
# never blocks or fails a request.
GEOIP_ENABLED=true
GEOIP_URL=https://ipwho.is
GEOIP_TIMEOUT_SECONDS=2.0

# Transactional email for email confirmation and password recovery.
# Fill these in for production. If SMTP_HOST is empty, development logs the
# message instead of sending it; production returns 503 from registration.
#
# Yandex Cloud Postbox (SMTP with an API key), see docs/YANDEX_POSTBOX.md:
#   SMTP_HOST=postbox.cloud.yandex.net
#   SMTP_PORT=587
#   SMTP_SECURITY=starttls
#   SMTP_USERNAME=<YANDEX_CLOUD_API_KEY_ID>
#   SMTP_PASSWORD=<YANDEX_CLOUD_API_KEY_SECRET>
# Port 587 uses STARTTLS; port 465 uses SMTPS (SMTP_SECURITY=ssl).
# SMTP_USERNAME is the API key ID (scope yc.postbox.send), not the service
# account ID. Never commit the real secret.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_FROM_EMAIL=noreply@fretfight.online
SMTP_FROM_NAME=GuitarBattle
SMTP_TIMEOUT_SECONDS=10

EMAIL_CODE_EXPIRE_MINUTES=15
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# Inbox for the public feedback form (POST /api/v1/feedback). The default is
# chumakevgeny@gmail.com; override to route feedback elsewhere. Delivery uses
# the SMTP_* settings above, and an unconfigured SMTP returns 503 instead of
# silently dropping the message.
FEEDBACK_EMAIL_TO=chumakevgeny@gmail.com

# Reward tuning (Battle + Online anti-farm, migration 0030). Everything is
# server-side: the client never sends these numbers. Exposed read-only by
# GET /api/v1/gameplay/rules. See docs/REWARDS_API.md.
# Battle XP decay per full tower completion: 1st run 1.0, 2nd 0.5, 3rd 0.25 ...
TOWER_REPEAT_DECAY=0.5
TOWER_REPEAT_FLOOR=0.05
# Online duel slots by finished duels of the same song in one UTC day.
ONLINE_REPEAT_FACTORS=1.0,0.5,0.25,0.1
ONLINE_REPEAT_FLOOR=0.05
# One-time personal-best bonus as a fraction of the base XP.
PB_BONUS_FACTOR=0.5
# normalized_score = actual / effective completion; NULL below 10%.
NORMALIZATION_MIN_COMPLETION=10.0
NORMALIZATION_MAX_MULTIPLIER=10.0
